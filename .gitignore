# Local raw archives and obsolete versions
archive/files/**
!archive/files/.gitkeep

# Generated previews and transient work
/tmp/
*.tmp
*.bak
*.swp
.DS_Store

# Common local credential files
.env
.env.*
!.env.example
*.pem
*.key

# Runtime dependencies (scripts have no runtime dependencies by default)
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
coverage/
