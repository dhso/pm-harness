# Local raw archives and obsolete versions
archive/files/**
!archive/files/.gitkeep

# Generated previews and transient work
/tmp/
.harness/cache/
.harness/tmp/
.harness/backups/
*.tmp
*.bak
*.swp
.DS_Store

# Common local credential files
.env
.env.*
!.env.example
*.pem
*.key

# Node artifacts (scripts have no runtime dependencies by default)
node_modules/
coverage/
