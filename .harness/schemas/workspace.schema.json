{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pm-harness/schema/workspace-v1.json",
  "title": "PM Harness workspace records",
  "type": "object",
  "$defs": {
    "date": {
      "type": ["string", "null"],
      "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timestamp": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "idList": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "scheduledItem": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["not_started", "in_progress", "blocked", "done", "cancelled"] },
        "owner": { "type": ["string", "null"] },
        "baseline_start": { "$ref": "#/$defs/date" },
        "baseline_end": { "$ref": "#/$defs/date" },
        "forecast_start": { "$ref": "#/$defs/date" },
        "forecast_end": { "$ref": "#/$defs/date" },
        "actual_start": { "$ref": "#/$defs/date" },
        "actual_end": { "$ref": "#/$defs/date" },
        "progress": { "type": "number", "minimum": 0, "maximum": 100 },
        "dependency_ids": { "$ref": "#/$defs/idList" },
        "requirement_ids": { "$ref": "#/$defs/idList" },
        "deliverable_ids": { "$ref": "#/$defs/idList" },
        "source_ids": { "$ref": "#/$defs/idList" },
        "next_action": { "type": ["string", "null"] },
        "evidence": { "type": ["string", "null"] },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "type", "title", "captured_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^SRC-\\d{3,}$" },
        "type": { "enum": ["email", "email_screenshot", "chat", "chat_screenshot", "daily_note", "office_document", "text_document", "external_connector", "other"] },
        "title": { "type": "string" },
        "channel": { "type": ["string", "null"] },
        "sender": { "type": ["string", "null"] },
        "thread_id": { "type": ["string", "null"] },
        "source_time": { "type": ["string", "null"] },
        "captured_at": { "$ref": "#/$defs/timestamp" },
        "archived_path": { "type": ["string", "null"] },
        "source_locator": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"] },
        "summary": { "type": "string" }
      }
    },
    "deliverable": {
      "type": "object",
      "required": ["id", "title", "type", "version", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^DEL-\\d{3,}$" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "format": { "type": ["string", "null"] },
        "version": { "type": "string" },
        "status": { "enum": ["requested", "drafting", "review", "approved", "delivered", "accepted", "superseded", "cancelled"] },
        "path": { "type": ["string", "null"] },
        "audience": { "type": ["string", "null"] },
        "purpose": { "type": ["string", "null"] },
        "requirement_ids": { "$ref": "#/$defs/idList" },
        "source_ids": { "$ref": "#/$defs/idList" },
        "due_at": { "$ref": "#/$defs/date" },
        "completed_at": { "$ref": "#/$defs/timestamp" },
        "approved_at": { "$ref": "#/$defs/timestamp" },
        "delivered_at": { "$ref": "#/$defs/timestamp" },
        "accepted_at": { "$ref": "#/$defs/timestamp" },
        "reviewers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "acceptance_evidence": { "type": ["string", "null"] },
        "supersedes_id": { "type": ["string", "null"], "pattern": "^DEL-\\d{3,}$" },
        "superseded_by_id": { "type": ["string", "null"], "pattern": "^DEL-\\d{3,}$" }
      }
    },
    "observation": {
      "type": "object",
      "required": ["id", "title", "pattern_key", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^OBS-\\d{3,}$" },
        "title": { "type": "string", "minLength": 1 },
        "pattern_key": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved", "dismissed"] },
        "proposal_id": { "type": ["string", "null"], "pattern": "^RULE-\\d{3,}$" },
        "evidence": { "type": ["string", "null"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "resolved_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "proposal": {
      "type": "object",
      "required": ["id", "title", "status", "observation_ids", "proposed_rule", "scope", "expected_benefit", "possible_side_effects", "evaluation_metric", "review_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^RULE-\\d{3,}$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "approved", "active", "rejected", "retired"] },
        "observation_ids": { "$ref": "#/$defs/idList" },
        "proposed_rule": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "expected_benefit": { "type": "string", "minLength": 1 },
        "possible_side_effects": { "type": "string", "minLength": 1 },
        "evaluation_metric": { "type": "string", "minLength": 1 },
        "review_at": { "anyOf": [{ "$ref": "#/$defs/date" }, { "$ref": "#/$defs/timestamp" }] },
        "approved_by": { "type": ["string", "null"] },
        "effective_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "archiveFile": {
      "type": "object",
      "required": ["id", "logical_id", "path", "original_name", "type", "sha256", "archived_at", "reason", "availability"],
      "properties": {
        "id": { "type": "string", "pattern": "^ARC-\\d{3,}$" },
        "logical_id": { "type": "string", "minLength": 1 },
        "source_id": { "type": ["string", "null"], "pattern": "^SRC-\\d{3,}$" },
        "deliverable_id": { "type": ["string", "null"], "pattern": "^DEL-\\d{3,}$" },
        "path": { "type": "string", "minLength": 1 },
        "original_name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "archived_at": { "$ref": "#/$defs/timestamp" },
        "reason": { "type": "string", "minLength": 1 },
        "superseded_by": { "type": ["string", "null"] },
        "availability": { "enum": ["local", "missing", "external", "deleted"] }
      }
    }
  },
  "properties": {
    "project": { "type": "object" },
    "schedule": {
      "type": "object",
      "properties": {
        "milestones": { "type": "array", "items": { "$ref": "#/$defs/scheduledItem" } },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/scheduledItem" } }
      }
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "deliverables": { "type": "array", "items": { "$ref": "#/$defs/deliverable" } },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } },
    "archive_files": { "type": "array", "items": { "$ref": "#/$defs/archiveFile" } }
  }
}
